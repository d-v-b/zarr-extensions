{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "const": "endian"
    },
    "configuration": {
      "type": "object",
      "properties": {
        "endian": {
          "type": "string",
          "enum": ["little", "big"]
        }
      },
      "required": ["endian"],
      "additionalProperties": false
    }
  },
  "required": ["name", "configuration"],
  "additionalProperties": false
}
