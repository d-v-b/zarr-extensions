{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "const": "numcodecs.blosc"
    },
    "configuration": {
      "type": "object",
      "properties": {
        "id": {
          "const": "blosc"
        },
        "cname": {
          "type": "string",
          "enum": ["blosclz", "lz4", "lz4hc", "zlib", "zstd", "snappy"]
        },
        "clevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "shuffle": {
          "type": "integer",
          "enum": [-1, 0, 1, 2]
        },
        "blocksize": {
          "type": "integer",
          "minimum": 0
        },
        "typesize": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["name", "configuration"],
  "additionalProperties": false
}
