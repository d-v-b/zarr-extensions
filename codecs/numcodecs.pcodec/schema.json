{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": { "const": "numcodecs.pcodec" },
    "configuration": {
      "type": "object",
      "properties": {
        "id": { "const": "pcodec" },
        "level": { "type": "integer", "minimum": 0, "maximum": 12 },
        "mode_spec": { "type": "string", "enum": ["auto", "classic"] },
        "delta_spec": {
          "type": "string",
          "enum": ["auto", "no_op", "none", "try_consecutive", "try_lookback"]
        },
        "paging_spec": { "const": "equal_pages_up_to" },
        "delta_encoding_order": {
          "oneOf": [
            { "type": "integer", "minimum": 0, "maximum": 7 },
            { "type": "null" }
          ]
        },
        "equal_pages_up_to": { "type": "integer", "minimum": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "delta_encoding_order": { "type": "integer" }
            },
            "required": ["delta_encoding_order"]
          },
          "then": {
            "properties": {
              "delta_spec": { "enum": ["auto", "try_consecutive"] }
            }
          }
        },
        {
          "if": {
            "properties": { "delta_spec": { "const": "try_consecutive" } },
            "required": ["delta_spec"]
          },
          "then": {
            "properties": {
              "delta_encoding_order": { "type": "integer" }
            },
            "required": ["delta_encoding_order"]
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "required": ["name", "configuration"],
  "additionalProperties": false
}
