{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "const": "numcodecs.zlib"
    },
    "configuration": {
      "type": "object",
      "properties": {
        "id": {
          "const": "zlib"
        },
        "level": {
          "type": "integer",
          "minimum": -1,
          "maximum": 9
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["name", "configuration"],
  "additionalProperties": false
}
