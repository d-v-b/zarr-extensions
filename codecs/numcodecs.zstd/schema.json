{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "const": "numcodecs.zstd"
    },
    "configuration": {
      "type": "object",
      "properties": {
        "id": {
          "const": "zstd"
        },
        "level": {
          "type": "integer",
          "minimum": -131072,
          "maximum": 22
        },
        "checksum": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["name", "configuration"],
  "additionalProperties": false
}
